<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FHoutGen.Extract</RootNamespace>
    <AssemblyName>fhout-extract</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The vendored DereTore source is not written for nullable analysis. -->
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS0168;CS0219</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The demo's vendored DereTore (ACB / AWB / HCA), compiled from its source so the PCM matches what the demo plays. -->
    <DereToreDir>$(MSBuildThisFileDirectory)..\..\demo\Assets\Scripts\ThirdParty\DereTore\</DereToreDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(DereToreDir)Archive.ACB\**\*.cs" Link="DereTore\Archive.ACB\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(DereToreDir)Audio.HCA\**\*.cs" Link="DereTore\Audio.HCA\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(DereToreDir)Common\**\*.cs" Link="DereTore\Common\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AssetsTools.NET" Version="3.0.5" />
  </ItemGroup>

</Project>
